;;; cold-start-check.el --- Checks in a disposable Doom daemon -*- lexical-binding: t; -*-

;; Run with tests/run-cold-start-check.sh, never in the user's server.
(require 'cl-lib)
(require 'evil)
(evil-mode 1)

(let* ((phase (string-to-number (or (getenv "DOOM_REFACTOR_PHASE") "5")))
       (buffer (get-buffer-create " *doom-refactor-check*")))
  (switch-to-buffer buffer)
  (fundamental-mode)
  (evil-normal-state)
  (cl-labels
      ((leaders ()
         (cl-assert (eq evil-state 'normal))
         (dolist (test '(("o p" . pilish)
                         ("t t" . my/table-pretty-toggle)
                         ("o T" . my/vterm-here)))
           (cl-assert (eq (lookup-key doom-leader-map (kbd (car test))) (cdr test))
                      nil "Wrong direct leader: %S" test)
           (cl-assert (eq (key-binding (kbd (concat "SPC " (car test)))) (cdr test))
                      nil "Wrong effective leader: %S" test)
           (cl-assert (commandp (cdr test)))))
       (new-origin (name)
         (let ((file (locate-library name)))
           (cl-assert (and file (not (string-match-p "/site-lisp/" file)))
                      nil "Unexpected library origin: %s = %s" name file)
           (message "%s: %s" name file))))
    (leaders)
    (dolist (command '(yank-rich-rich yank-rich-plain yank-rich yank-plain))
      (cl-assert (commandp command)))
    (cl-assert (featurep 'yank-rich-evil))
    (cl-assert (eq (lookup-key evil-normal-state-map (kbd "y")) 'evil-yank))
    (cl-assert (eq (key-binding (kbd "gyr")) 'yank-rich))
    (cl-assert (eq (key-binding (kbd "gyp")) 'yank-plain))
    (new-origin "yank-rich")
    (new-origin "yank-rich-evil")
    (let ((dir (file-name-directory (locate-library "yank-rich"))))
      (cl-assert (file-exists-p (expand-file-name "yank-rich.elc" dir)))
      (cl-assert (not (file-exists-p (expand-file-name "yank-rich-evil.elc" dir)))))
    (when (>= phase 2)
      (new-origin "table-pretty")
      (new-origin "markdown-table-wrap")
      (cl-assert (not (locate-library "markdown-table-wrap-pretty")))
      (cl-assert (not (fboundp 'markdown-table-wrap-pretty-toggle)))
      (cl-assert (file-exists-p
                  (expand-file-name "table-pretty.elc"
                                    (file-name-directory (locate-library "table-pretty"))))))
    ;; These are normal md-ts prerequisites, not installed by this test.
    ;; Fail clearly instead of waiting at an interactive grammar prompt.
    (require 'treesit)
    (dolist (language '(markdown markdown-inline))
      (cl-assert (treesit-language-available-p language) nil
                 "Install the %s tree-sitter grammar before cold checks" language))
    ;; Loading representative major modes must not replace personal keys.
    (dolist (mode '(markdown-mode gfm-mode md-ts-mode org-mode))
      (funcall mode)
      (evil-normal-state)
      (leaders)
      (when (>= phase 2)
        (erase-buffer)
        (insert "| a | b |\n|---|---|\n| one | two |\n")
        (let ((source (buffer-string)))
          (goto-char (point-min))
          (my/table-pretty-toggle '(4))
          (cl-assert (equal source (buffer-string)))
          (my/table-pretty-toggle '(16))
          (cl-assert (equal source (buffer-string))))))
    (cl-assert (null org-element-use-cache))
    (cl-assert org-startup-with-inline-images)
    (when (>= phase 3)
      (cl-assert (equal ob-mermaid-cli-path +sayre-mermaid-command))
      (cl-assert (file-executable-p ob-mermaid-cli-path))
      (cl-assert (eq (assoc-default "example.puml" auto-mode-alist 'string-match)
                     'plantuml-mode))
      (erase-buffer)
      (insert "#+begin_src mermaid\ngraph TD; A-->B;\n#+end_src\n\n"
              "#+begin_src plantuml\nAlice -> Bob\n#+end_src\n")
      (+org/fold-diagram-src-blocks)
      (goto-char (point-min))
      (forward-line)
      (cl-assert (org-invisible-p))
      (search-forward "Alice")
      (cl-assert (org-invisible-p)))
    (when (>= phase 4)
      (require 'pilish)
      (new-origin "pilish")
      (cl-assert (equal pilish-executable '("pi")))
      (cl-assert (eq pilish-project-trust-policy 'default))
      (cl-assert (eq pilish-evil-input-state 'normal))
      (cl-assert (eq pilish-input-window-display 'hidden))
      (cl-assert pilish-copy-raw-markdown)
      (cl-assert (not (file-exists-p
                       (expand-file-name "pilish.elc"
                                         (file-name-directory (locate-library "pilish"))))))
      (with-temp-buffer
        (pilish-chat-mode)
        (cl-assert doom-real-buffer-p)
        (cl-assert (not display-line-numbers-mode))
        (cl-assert (equal header-line-format '(:eval (pilish--header-line-string))))
        (cl-assert (not table-pretty-mode))
        (cl-assert (eq pilish-table-cell-render-function #'table-pretty-render-inline-spans))
        (cl-assert (eq (lookup-key pilish-chat-mode-map (kbd "C-c C-x C-k"))
                       'my/table-pretty-toggle)))
      (with-temp-buffer
        (pilish-input-mode)
        (cl-assert (not display-line-numbers-mode)))
      ;; Real-source warm reload, then definition origins (fixtures separately
      ;; prove cold reload and distinguishable stale bytecode without touching it).
      (pi-reload)
      (dolist (function '(pilish pilish--setup-session pilish--raw-markdown-filter))
        (when (fboundp function)
          (let ((file (symbol-file function 'defun)))
            (cl-assert (and file (string-suffix-p ".el" file)
                            (file-in-directory-p file +sayre-pilish-source-dir))
                       nil "Reloaded definition origin: %S = %S" function file))))
      (my/pilish-toggle-backend)
      (cl-assert (equal pilish-executable '("omp")))
      (cl-assert (eq pilish-project-trust-policy 'default))
      (my/pilish-toggle-backend)
      (cl-assert (equal pilish-executable '("pi")))
      (cl-assert (eq pilish-project-trust-policy 'approve)))
    (when (>= phase 5)
      ;; Doom can add the package directory lazily when vterm is required.
      (cl-assert (locate-file "vterm-module"
                              (list (file-name-directory (locate-library "vterm")))
                              (get-load-suffixes)) nil
                 "Build vterm's native module before cold checks (M-x vterm-module-compile)")
      (require 'vterm)
      (cl-assert (eq (lookup-key vterm-mode-map (kbd "S-<return>"))
                     '+my/find-file-at-point-other-window))
      (cl-assert (eq (lookup-key doom-leader-map (kbd "o t")) '+vterm/toggle)))
    (when (>= phase 4)
      (cl-assert (not (cl-find-if (lambda (dir) (string-match-p "/site-lisp/" dir)) load-path))))
    (message "Cold-start phase %d checks passed" phase)))

:ok
